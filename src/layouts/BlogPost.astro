---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Article pages keep the paper ground but drop the grid for a
			   single reading measure. The hero spans the full page gutter. */
			.hero-image {
				width: 100%;
				aspect-ratio: 2 / 1;
				overflow: hidden;
				background: var(--bg-sunk);
				margin: 3rem 0 3.5rem;
			}
			.hero-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.title {
				max-width: var(--column);
				margin-bottom: 3rem;
			}
			.title h1 {
				margin: 0 0 0.5rem 0;
			}
			.date {
				margin-bottom: 0;
				color: var(--text-muted);
				font-size: var(--size-nav);
				letter-spacing: var(--track-nav);
				text-transform: uppercase;
			}
			.prose {
				max-width: var(--column);
				font-family: var(--font-display);
				line-height: 1.5;
				color: var(--text);
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 2em;
			}
			.prose :global(img) {
				margin: 2em 0;
			}
			.back {
				display: inline-block;
				margin-top: 5rem;
				font-size: var(--size-nav);
				letter-spacing: var(--track-nav);
				text-transform: uppercase;
				text-decoration: none;
				color: var(--text-muted);
			}
			.back:hover {
				color: var(--text);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1600} height={800} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="title">
					<h1>{title}</h1>
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
				<a class="back" href="/blog">← Back to writing</a>
			</article>
		</main>
		<Footer />
	</body>
</html>
