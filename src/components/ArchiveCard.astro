---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	/** Small line above the title — category, tag list, or date. */
	kicker?: string;
	/** Small line below the title — description or note. */
	note?: string;
	image?: ImageMetadata;
	external?: boolean;
}

const { href, title, kicker, note, image, external = false } = Astro.props;
const linkAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

<a class="card" href={href} {...linkAttrs}>
	<div class="tile">
		{
			image ? (
				<Image src={image} alt="" width={640} height={853} />
			) : (
				<span class="tile-empty" aria-hidden="true" />
			)
		}
	</div>
	<div class="caption">
		{kicker && <span class="kicker nav-type">{kicker}</span>}
		<span class="title serif">{title}</span>
		{note && <span class="note">{note}</span>}
	</div>
</a>
<style>
	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}
	.tile {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: var(--bg-sunk);
	}
	.tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.3s ease;
	}
	.card:hover .tile :global(img) {
		opacity: 0.8;
	}
	.tile-empty {
		display: block;
		width: 100%;
		height: 100%;
	}
	.caption {
		padding-top: 0.6rem;
	}
	.kicker {
		display: block;
		color: var(--text-faint);
	}
	.title {
		display: block;
		font-size: 1rem;
		line-height: 1.35;
	}
	.card:hover .title {
		opacity: 0.55;
	}
	.note {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--text-muted);
	}
</style>
