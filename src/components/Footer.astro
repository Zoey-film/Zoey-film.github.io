---
const today = new Date();
---

<footer class="nav-type">
	<span>&copy; {today.getFullYear()} Zoey Zhang</span>
	<span class="links">
		<a href="https://github.com/Zoey-film" target="_blank" rel="noopener">GitHub</a>
		<a href="mailto:zoey@flick.art">Email</a>
	</span>
</footer>
<style>
	footer {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding: 0 var(--page-margin) 14px;
		color: var(--text-muted);
	}
	.links {
		display: flex;
		gap: 1.75rem;
	}
	footer a {
		text-decoration: none;
		color: var(--text-muted);
	}
	footer a:hover {
		color: var(--text);
	}
</style>
