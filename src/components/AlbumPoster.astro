---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Album } from '../data/playlist';

interface Props {
	album: Album;
	/** Undefined when the album has no cover art yet. */
	image?: ImageMetadata;
	palette: string[];
	/** Pre-validated Spotify embed URL, or undefined. */
	embed?: string;
}

const { album, image, palette, embed } = Astro.props;

const released = album.releaseDate
	? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: '2-digit' }).format(
			new Date(album.releaseDate),
		)
	: album.year
		? String(album.year)
		: undefined;

const tracks = album.tracks ?? [];

// Track list flows into columns; roughly five per column keeps the block
// balanced the way the reference posters do.
const columns = Math.min(3, Math.max(1, Math.ceil(tracks.length / 5)));

// Long classical titles would otherwise set at display size and swamp the
// poster, so the title steps down as it gets longer.
const titleScale = album.title.length > 60 ? 'xs' : album.title.length > 34 ? 'sm' : 'lg';
---

<article class="poster" data-poster>
	<div class="art">
		{
			image ? (
				<Image src={image} alt={`${album.title} by ${album.artist}`} widths={[400, 800]} />
			) : (
				<span class="art-empty" aria-hidden="true" />
			)
		}
	</div>

	{
		palette.length > 0 && (
			<div class="swatches" aria-hidden="true">
				{palette.map((hex) => (
					<span style={`background:${hex}`} />
				))}
			</div>
		)
	}

	<div class="head">
		<div class="names">
			<h2 class:list={['album-title', titleScale]}>{album.title}</h2>
			<p class="artist">{album.artist}</p>
		</div>
		{
			embed && (
				<button class="play" type="button" data-play aria-expanded="false">
					<span class="sr-only">Play {album.title}</span>
					<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
						<circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.6" />
						<path d="M10 8.2 16 12l-6 3.8Z" fill="currentColor" />
					</svg>
				</button>
			)
		}
	</div>

	{
		tracks.length > 0 && (
			<ol class="tracks" style={`--track-cols:${columns}`}>
				{tracks.map((track) => (
					<li>{track}</li>
				))}
			</ol>
		)
	}

	{
		embed && (
			<div class="player" data-player hidden>
				{/* src is set on first click so nothing is fetched from Spotify
				    unless a visitor actually asks to listen. */}
				<iframe
					data-src={`${embed}?theme=0`}
					width="100%"
					height="152"
					frameborder="0"
					loading="lazy"
					title={`Spotify player — ${album.title}`}
					allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
				/>
			</div>
		)
	}

	{
		(released || album.album || album.label) && (
			<footer class="meta">
				{album.album && <span>{album.album}</span>}
				{released && <span>{released}</span>}
				{album.label && <span>{album.label}</span>}
			</footer>
		)
	}
</article>
<style>
	.poster {
		background: var(--poster-bg);
		padding: 18px 18px 22px;
		display: flex;
		flex-direction: column;
	}
	.art :global(img) {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		display: block;
	}
	.art-empty {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		background: rgba(0, 0, 0, 0.06);
	}

	/* Colour bar derived from the artwork. */
	.swatches {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		height: 16px;
		margin-top: 10px;
	}

	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1.1rem;
	}
	.album-title {
		font-family: var(--font-body);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		margin: 0;
	}
	.album-title.lg {
		font-size: clamp(1.5rem, 4.5vw, 2.1rem);
	}
	.album-title.sm {
		font-size: 1.4rem;
	}
	.album-title.xs {
		font-size: 1.1rem;
		line-height: 1.15;
	}
	.artist {
		font-weight: 500;
		font-size: 1.05rem;
		line-height: 1.2;
		margin: 0.25rem 0 0;
	}
	.play {
		flex: none;
		appearance: none;
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
		color: var(--text);
		transition: color 0.2s ease;
	}
	.play:hover {
		color: var(--link-hover);
	}

	.tracks {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		column-count: var(--track-cols, 1);
		column-gap: 1.5rem;
		font-size: 0.85rem;
		line-height: 1.55;
	}
	.tracks li {
		break-inside: avoid;
	}

	/* Spotify's chrome can't be themed from outside the iframe, so it only
	   appears once a visitor asks for it. */
	.player {
		margin-top: 1rem;
	}
	.player iframe {
		display: block;
		border-radius: 8px;
	}

	.meta {
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.play {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-poster]').forEach((poster) => {
		const button = poster.querySelector<HTMLButtonElement>('[data-play]');
		const player = poster.querySelector<HTMLElement>('[data-player]');
		const frame = player?.querySelector<HTMLIFrameElement>('iframe');
		if (!button || !player || !frame) return;

		button.addEventListener('click', () => {
			const opening = player.hasAttribute('hidden');

			if (opening) {
				// Defer the Spotify request until someone actually wants it.
				if (!frame.src && frame.dataset.src) frame.src = frame.dataset.src;
				player.removeAttribute('hidden');
			} else {
				player.setAttribute('hidden', '');
			}

			button.setAttribute('aria-expanded', String(opening));
		});
	});
</script>
