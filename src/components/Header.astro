---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="nav-type">
	<a class="wordmark" href="/">{SITE_TITLE}</a>
	<nav class="nav-columns">
		<div class="col">
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
		</div>
		<div class="col">
			<HeaderLink href="/collection">Collection</HeaderLink>
			<a href="mailto:zoey@flick.art">Contact</a>
		</div>
	</nav>
	<div class="utility col">
		<a href="https://github.com/Zoey-film" target="_blank" rel="noopener">GitHub</a>
		<a href="/rss.xml">RSS</a>
	</div>
</header>
<style>
	header {
		display: flex;
		align-items: flex-start;
		gap: var(--nav-col);
		padding: 14px var(--page-margin) 0;
	}
	.wordmark {
		letter-spacing: 0.22em;
		text-decoration: none;
		white-space: nowrap;
		flex: none;
	}
	.nav-columns {
		display: flex;
		gap: var(--nav-col);
	}
	.col {
		display: flex;
		flex-direction: column;
	}
	/* The utility links sit hard against the right edge, as on the reference. */
	.utility {
		margin-left: auto;
		text-align: right;
	}
	.utility a {
		text-decoration: none;
		color: var(--text-muted);
	}
	.utility a:hover {
		color: var(--text);
	}

	@media (max-width: 900px) {
		header {
			flex-wrap: wrap;
			gap: 2rem;
		}
		.nav-columns {
			gap: 2rem;
		}
	}
	@media (max-width: 600px) {
		header {
			gap: 1.25rem;
		}
		.nav-columns {
			gap: 1.5rem;
		}
		.utility {
			margin-left: 0;
			text-align: left;
			flex-direction: row;
			gap: 1.5rem;
		}
	}
</style>
