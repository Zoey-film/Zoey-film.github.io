---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="nav-type" data-header>
	<a class="wordmark" href="/">{SITE_TITLE}</a>
	<nav class="nav-columns">
		<div class="col">
			<HeaderLink href="/projects">Works</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
		</div>
		<div class="col">
			<HeaderLink href="/collection">Collection</HeaderLink>
			<HeaderLink href="/playlist">Playlist</HeaderLink>
		</div>
	</nav>
</header>
<style>
	/* Fixed in place — no hide-on-scroll. The header carries no background:
	   its text is set white and mix-blend-mode: difference inverts it against
	   whatever scrolls beneath, so it reads near-black over the cream page,
	   light over dark imagery, and picks up complementary tints over color. */
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		align-items: flex-start;
		gap: var(--nav-col);
		padding: 14px var(--page-margin) 14px;
		color: #fff;
		mix-blend-mode: difference;
	}
	/* Ancient browsers without blend support would otherwise show white text
	   on a white page — fall back to a plain solid header. */
	@supports not (mix-blend-mode: difference) {
		header {
			mix-blend-mode: normal;
			color: var(--text);
			background: var(--bg);
		}
	}

	.wordmark {
		letter-spacing: 0.22em;
		text-decoration: none;
		white-space: nowrap;
		flex: none;
		color: inherit;
	}
	.nav-columns {
		display: flex;
		gap: var(--nav-col);
	}
	.col {
		display: flex;
		flex-direction: column;
	}

	@media (max-width: 900px) {
		header {
			flex-wrap: wrap;
			gap: 2rem;
		}
		.nav-columns {
			gap: 2rem;
		}
	}
	@media (max-width: 600px) {
		header {
			gap: 1.25rem;
		}
		.nav-columns {
			gap: 1.5rem;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');

	if (header) {
		// Publish the real measured height so <main> reserves exactly the right
		// space. The header wraps to a taller layout on narrow screens, so a
		// hardcoded value would be wrong at some widths.
		const syncHeight = () => {
			document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
		};
		syncHeight();
		window.addEventListener('resize', syncHeight, { passive: true });
		if (document.fonts) document.fonts.ready.then(syncHeight);
	}
</script>
