---
import { getCollection } from 'astro:content';
import ArchiveCard from '../../components/ArchiveCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { externalWriting } from '../../data/writing';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

// Local posts plus pieces published elsewhere, newest first.
const entries = [
	...posts.map((p) => ({
		title: p.data.title,
		href: `/blog/${p.id}/`,
		kicker: dateFormat.format(p.data.pubDate),
		note: p.data.description,
		image: p.data.heroImage,
		time: p.data.pubDate.valueOf(),
		external: false,
	})),
	...externalWriting.map((p) => ({
		title: p.title,
		href: p.href,
		kicker: [p.publication, p.date && dateFormat.format(new Date(p.date))]
			.filter(Boolean)
			.join(' · '),
		note: p.description,
		image: undefined,
		time: p.date ? new Date(p.date).valueOf() : -Infinity,
		external: true,
	})),
].sort((a, b) => b.time - a.time);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description="Writing and notes." />
	</head>
	<body>
		<Header />
		<main>
			<div class="index-bar nav-type">
				<span>Writing</span>
				<span>{entries.length} items</span>
			</div>
			<div class="grid">
				{
					entries.map((entry) => (
						<ArchiveCard
							href={entry.href}
							title={entry.title}
							kicker={entry.kicker}
							note={entry.note}
							image={entry.image}
							external={entry.external}
						/>
					))
				}
			</div>
			{entries.length === 0 && <p class="nav-type">Nothing published yet</p>}
		</main>
		<Footer />
		<style>
			.index-bar {
				display: flex;
				justify-content: space-between;
				padding: 6rem 0 1.5rem;
				color: var(--text-muted);
			}
			@media (max-width: 900px) {
				.index-bar {
					padding: 3rem 0 1.25rem;
				}
			}
		</style>
	</body>
</html>
