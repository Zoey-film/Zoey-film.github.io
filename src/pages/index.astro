---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import homeImage from '../assets/Girl.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { projects } from '../data/projects';
import { social } from '../data/social';
import { externalWriting } from '../data/writing';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Local posts and pieces published elsewhere sit in one list, newest first.
// Entries without a date sort to the end.
const writing = [
	...posts.map((p) => ({
		title: p.data.title,
		href: `/blog/${p.id}/`,
		time: p.data.pubDate.valueOf(),
		external: false,
	})),
	...externalWriting.map((p) => ({
		title: p.title,
		href: p.href,
		time: p.date ? new Date(p.date).valueOf() : -Infinity,
		external: true,
	})),
].sort((a, b) => b.time - a.time);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- The statement column: pinned left, narrow, with the rest of the
			     page deliberately left empty. -->
			<section class="statement justified">
				<p>
					Zoey Zhang is President and Co-Founder of <a
						href="https://flick.art"
						target="_blank"
						rel="noopener">Flick</a
					>, an AI filmmaking platform built for filmmakers to direct, create, and tell stories
					with emerging technology.
				</p>
				<!-- Swap the image by dropping a new file in src/assets/ and updating
				     the `homeImage` import above. Write a real alt describing it. -->
				<figure class="plate">
					<Image src={homeImage} alt="" widths={[350, 700, 1184]} />
				</figure>

				<p>
					Based in California, she works across technology, filmmaking, and design, with a
					particular interest in how new creative tools can expand the language of cinema.
				</p>
			</section>

			<!-- Index: quiet columns of links, set in the nav type. Each link shows
			     only its label — the URL lives in the href. -->
			<section class="index">
				<div class="index-col nav-type">
					<span class="index-head">Projects</span>
					{
						projects.map((project) => (
							<a href={project.link} target="_blank" rel="noopener">
								{project.title}
							</a>
						))
					}
				</div>
				<div class="index-col nav-type">
					<span class="index-head">Writing</span>
					{
						writing.slice(0, 6).map((item) => (
							<a
								href={item.href}
								{...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
							>
								{item.title}
							</a>
						))
					}
					{writing.length === 0 && <span class="empty">Nothing published yet</span>}
				</div>
				<div class="index-col nav-type">
					<span class="index-head">Social</span>
					{
						social.map((item) => (
							<a href={item.href} target="_blank" rel="noopener me">
								{item.label}
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
		<style>
			/* A narrow measure is what makes justification read — fewer words per
			   line means wider gaps. Widen this and the effect flattens out. */
			.statement {
				max-width: 350px;
				margin: 0 auto;
				padding: 14rem 0 16rem;
				line-height: 1.8;
			}

			/* Image sits in the text column at full measure, so its edges line up
			   with the justified type on both sides. The margin here wins over the
			   neighbouring paragraph's (adjacent margins collapse), so this single
			   value controls the gap above and below. */
			.plate {
				margin: 1.1rem 0;
			}
			.plate :global(img) {
				width: 100%;
				height: auto;
			}
			.plate.placeholder {
				aspect-ratio: 4 / 3;
				background: var(--bg-sunk);
			}
			.statement p {
				margin-bottom: 1.75em;
			}
			.statement p:last-child {
				margin-bottom: 0;
			}

			.index {
				display: flex;
				gap: var(--nav-col);
				padding-bottom: 4rem;
			}
			.index-col {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
				min-width: 180px;
			}
			.index-head {
				color: var(--text-faint);
				margin-bottom: 0.6rem;
			}
			.index-col a {
				align-self: flex-start;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.index-col a:hover,
			.index-col a:focus-visible {
				color: var(--link-hover);
			}
			@media (prefers-reduced-motion: reduce) {
				.index-col a {
					transition: none;
				}
			}
			.empty {
				color: var(--text-faint);
			}

			@media (max-width: 900px) {
				.statement {
					padding: 6rem 0 7rem;
				}
				.index {
					gap: 3rem;
					flex-wrap: wrap;
				}
			}
		</style>
	</body>
</html>
