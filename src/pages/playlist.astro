---
import type { ImageMetadata } from 'astro';
import AlbumPoster from '../components/AlbumPoster.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { albums } from '../data/playlist';
import { extractPalette } from '../lib/palette';

// Covers live in src/assets/albums/ and are matched to entries by filename.
const covers = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/albums/*.{jpeg,jpg,png,webp,avif}',
	{ eager: true },
);

const byFilename = new Map(
	Object.entries(covers).map(([path, mod]) => [path.split('/').pop() ?? '', mod.default]),
);

// Accept either a share link or an embed URL, and refuse anything that isn't
// Spotify so a stray paste can't drop an arbitrary iframe onto the page.
function toEmbedUrl(raw: string | undefined): string | undefined {
	if (!raw) return undefined;
	let url: URL;
	try {
		url = new URL(raw);
	} catch {
		return undefined;
	}
	if (url.hostname !== 'open.spotify.com') return undefined;
	const match = url.pathname
		.replace(/^\/embed/, '')
		.match(/^\/(track|album|playlist|episode|show)\/([A-Za-z0-9]+)$/);
	return match ? `https://open.spotify.com/embed/${match[1]}/${match[2]}` : undefined;
}

// An album without cover art still gets a poster — it just renders with a
// plain tile and no colour bar.
const posters = (
	await Promise.all(
		albums.map(async (album) => {
			const image = album.cover ? byFilename.get(album.cover) : undefined;
			if (album.cover && !image) {
				console.warn(`[playlist] no cover found for "${album.title}" (${album.cover})`);
			}
			const palette = image ? await extractPalette(`src/assets/albums/${album.cover}`) : [];
			return { album, image, palette, embed: toEmbedUrl(album.spotify) };
		}),
	)
).sort((a, b) => {
		const t = (x: typeof a) => (x.album.releaseDate ? new Date(x.album.releaseDate).valueOf() : 0);
		return t(b) - t(a);
	});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Playlist | ${SITE_TITLE}`} description="Albums on rotation." />
	</head>
	<body>
		<Header />
		<main>
			<div class="index-bar nav-type">
				<span>Playlist</span>
				<span>{posters.length} {posters.length === 1 ? 'album' : 'albums'}</span>
			</div>

			{
				posters.length > 0 ? (
					<div class="posters">
						{posters.map((p) => (
							<AlbumPoster
								album={p.album}
								image={p.image}
								palette={p.palette}
								embed={p.embed}
							/>
						))}
					</div>
				) : (
					<p class="empty nav-type">Nothing here yet.</p>
				)
			}
		</main>
		<Footer />
		<style>
			.index-bar {
				display: flex;
				justify-content: space-between;
				padding: 6rem 0 1.5rem;
				color: var(--text-muted);
			}
			.posters {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 28px;
			}
			.empty {
				color: var(--text-faint);
			}
			@media (max-width: 900px) {
				.index-bar {
					padding: 3rem 0 1.25rem;
				}
			}
		</style>
	</body>
</html>
