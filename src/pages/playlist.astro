---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { playlist, tracks } from '../data/playlist';
import { extractPalette } from '../lib/palette';

const covers = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/albums/*.{jpeg,jpg,png,webp,avif}',
	{ eager: true },
);
const cover = covers[`/src/assets/albums/${playlist.cover}`]?.default;
const palette = cover ? await extractPalette(`src/assets/albums/${playlist.cover}`) : [];

// Accept a share link or an embed URL, and refuse anything that isn't Spotify
// so a stray paste can't put an arbitrary iframe on the page.
function toEmbedUrl(raw: string): string | null {
	let url: URL;
	try {
		url = new URL(raw);
	} catch {
		return null;
	}
	if (url.hostname !== 'open.spotify.com') return null;
	const match = url.pathname
		.replace(/^\/embed/, '')
		.match(/^\/(track|album|playlist|episode|show)\/([A-Za-z0-9]+)$/);
	return match ? `https://open.spotify.com/embed/${match[1]}/${match[2]}?theme=0` : null;
}

const items = tracks
	.map((t) => ({ ...t, embed: toEmbedUrl(t.spotify) }))
	.filter((t) => t.embed !== null);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Playlist | ${SITE_TITLE}`} description="Music on rotation." />
	</head>
	<body>
		<Header />
		<main>
			<div class="index-bar nav-type">
				<span>Playlist</span>
				<span>{items.length} tracks</span>
			</div>

			<article class="poster">
				<div class="art">
					{
						cover ? (
							<Image src={cover} alt="" widths={[400, 800]} />
						) : (
							<span class="art-empty" aria-hidden="true" />
						)
					}
				</div>

				{
					palette.length > 0 && (
						<div class="swatches" aria-hidden="true">
							{palette.map((hex) => (
								<span style={`background:${hex}`} />
							))}
						</div>
					)
				}

				<header class="head">
					<h1 class="title">{playlist.title}</h1>
					<p class="subtitle">{playlist.subtitle}</p>
				</header>

				<!-- Clicking a row loads it into the single player below, so the
				     list reads as one sequence rather than eight separate cards. -->
				<ol class="tracks">
					{
						items.map((track, i) => (
							<li>
								<button type="button" data-track={track.embed} aria-pressed="false">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="detail">
										<span class="track-title">{track.title}</span>
										<span class="track-artist">{track.artist}</span>
									</span>
								</button>
							</li>
						))
					}
				</ol>

				<div class="player" data-player hidden>
					<iframe
						data-frame
						width="100%"
						height="152"
						frameborder="0"
						loading="lazy"
						title="Spotify player"
						allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
				</div>

				<footer class="meta">
					<span>{playlist.year}</span>
				</footer>
			</article>
		</main>
		<Footer />
		<style>
			.index-bar {
				display: flex;
				justify-content: space-between;
				padding: 6rem 0 1.5rem;
				color: var(--text-muted);
			}

			.poster {
				background: var(--poster-bg);
				padding: 22px 22px 26px;
				max-width: 560px;
				display: flex;
				flex-direction: column;
			}
			.art :global(img) {
				width: 100%;
				aspect-ratio: 1;
				object-fit: cover;
				display: block;
			}
			.art-empty {
				display: block;
				width: 100%;
				aspect-ratio: 1;
				background: rgba(0, 0, 0, 0.06);
			}

			.swatches {
				display: grid;
				grid-auto-flow: column;
				grid-auto-columns: 1fr;
				height: 16px;
				margin-top: 10px;
			}

			.head {
				margin-top: 1.2rem;
			}
			.title {
				font-family: var(--font-body);
				font-weight: 700;
				font-size: 2.1rem;
				line-height: 1;
				letter-spacing: -0.01em;
				text-transform: uppercase;
				margin: 0;
			}
			.subtitle {
				font-weight: 500;
				font-size: 1.05rem;
				margin: 0.3rem 0 0;
			}

			.tracks {
				list-style: none;
				margin: 1.4rem 0 0;
				padding: 0;
			}
			.tracks button {
				appearance: none;
				background: none;
				border: 0;
				border-top: 1px solid rgba(0, 0, 0, 0.12);
				width: 100%;
				padding: 0.6rem 0;
				display: flex;
				gap: 0.9rem;
				align-items: baseline;
				text-align: left;
				font: inherit;
				color: inherit;
				cursor: pointer;
				transition: color 0.2s ease;
			}
			.tracks button:hover,
			.tracks button:focus-visible {
				color: var(--link-hover);
			}
			.tracks button[aria-pressed='true'] {
				color: var(--link-hover);
			}
			.num {
				flex: none;
				font-size: 0.72rem;
				opacity: 0.55;
				font-variant-numeric: tabular-nums;
			}
			.detail {
				display: flex;
				flex-direction: column;
				gap: 0.05rem;
			}
			.track-title {
				font-size: 0.9rem;
				line-height: 1.3;
			}
			.track-artist {
				font-size: 0.75rem;
				opacity: 0.6;
			}

			.player {
				margin-top: 1.2rem;
			}
			.player iframe {
				display: block;
				border-radius: 8px;
			}

			.meta {
				margin-top: 1.4rem;
				text-align: right;
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			@media (prefers-reduced-motion: reduce) {
				.tracks button {
					transition: none;
				}
			}
		</style>

		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('[data-track]');
			const player = document.querySelector<HTMLElement>('[data-player]');
			const frame = document.querySelector<HTMLIFrameElement>('[data-frame]');

			if (player && frame) {
				buttons.forEach((button) => {
					button.addEventListener('click', () => {
						const src = button.dataset.track;
						if (!src) return;

						// Nothing is requested from Spotify until a track is picked.
						frame.src = src;
						player.removeAttribute('hidden');

						buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
					});
				});
			}
		</script>
	</body>
</html>
