---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { tracks } from '../data/playlist';

// Accept either a share link or an embed URL, and refuse anything that isn't
// Spotify so a stray paste can't drop an arbitrary iframe onto the page.
// theme=0 gives the dark player.
const players = tracks
	.map((raw) => {
		let url: URL;
		try {
			url = new URL(raw);
		} catch {
			return null;
		}
		if (url.hostname !== 'open.spotify.com') return null;
		const match = url.pathname
			.replace(/^\/embed/, '')
			.match(/^\/(track|album|playlist|episode|show)\/([A-Za-z0-9]+)$/);
		return match ? `https://open.spotify.com/embed/${match[1]}/${match[2]}?theme=0` : null;
	})
	.filter((u) => u !== null);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Playlist | ${SITE_TITLE}`} description="Music on rotation." />
	</head>
	<body>
		<Header />
		<main>
			<div class="index-bar nav-type">
				<span>Playlist</span>
				<span>{players.length} {players.length === 1 ? 'track' : 'tracks'}</span>
			</div>

			{
				players.length > 0 ? (
					<ol class="tracks">
						{players.map((src) => (
							<li>
								{/* lazy so the players below the fold aren't fetched
								    from Spotify until they're scrolled to */}
								<iframe
									src={src}
									width="100%"
									height="152"
									frameborder="0"
									loading="lazy"
									title="Spotify player"
									allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
								/>
							</li>
						))}
					</ol>
				) : (
					<p class="empty nav-type">Nothing here yet.</p>
				)
			}
		</main>
		<Footer />
		<style>
			.index-bar {
				display: flex;
				justify-content: space-between;
				padding: 6rem 0 1.5rem;
				color: var(--text-muted);
			}
			.tracks {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 12px;
				max-width: 560px;
			}
			.tracks iframe {
				display: block;
				border-radius: 12px;
			}
			.empty {
				color: var(--text-faint);
			}
			@media (max-width: 900px) {
				.index-bar {
					padding: 3rem 0 1.25rem;
				}
			}
		</style>
	</body>
</html>
