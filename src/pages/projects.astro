---
import type { ImageMetadata } from 'astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { projects } from '../data/projects';

// Cover images live directly in src/assets/ and are matched to a project by
// the `cover` filename in projects.ts.
const covers = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/*.{jpeg,jpg,png,webp,avif}',
	{ eager: true },
);
const coverFor = (filename?: string) =>
	filename ? covers[`/src/assets/${filename}`]?.default : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Works | ${SITE_TITLE}`} description="Selected work and projects." />
	</head>
	<body>
		<Header />
		<main>
			<div class="index-bar nav-type">
				<span>Works</span>
				<span>{projects.length} items</span>
			</div>
			<div class="grid">
				{
					projects.map((project) => (
						<ArchiveCard
							href={project.link}
							title={project.title}
							kicker={project.tags.join(' / ')}
							note={project.description}
							image={coverFor(project.cover)}
							ratio={project.ratio}
							external
						/>
					))
				}
			</div>
		</main>
		<Footer />
		<style>
			.index-bar {
				display: flex;
				justify-content: space-between;
				padding: 6rem 0 1.5rem;
				color: var(--text-muted);
			}
			@media (max-width: 900px) {
				.index-bar {
					padding: 3rem 0 1.25rem;
				}
			}
		</style>
	</body>
</html>
